---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
import { topics } from '../lib/topics';

const latestAgent = (await getCollection('posts', ({ data }) => data.topic === 'agent-building')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)[0];

const latestKnowledge = (await getCollection('posts', ({ data }) => data.topic === 'knowledge')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)[0];

const knowledgeTopic = topics.knowledge;
const agentTopic = topics['agent-building'];
const knowledgeFallback = knowledgeTopic.pinned;

const knowledgeEntry = latestKnowledge
  ? {
      title: latestKnowledge.data.title,
      href: withBase(`/${knowledgeTopic.key}/${latestKnowledge.id}/`),
      line: latestKnowledge.data.dek,
    }
  : {
      title: knowledgeFallback?.title ?? knowledgeTopic.label,
      href: withBase(knowledgeFallback?.href ?? knowledgeTopic.href),
      line: knowledgeFallback?.summary ?? knowledgeTopic.description,
    };
---

<BaseLayout
  title="Edi Rodin"
  description="I build systems that turn messy organisational knowledge into answers agents can trust."
>
  <header class="identity">
    <h1>Edi Rodin</h1>
    <p class="role">
      I build systems that turn messy organisational knowledge into answers agents can trust.
    </p>
    <p class="place">Israel</p>
    <ul class="link-row">
      <li><a href="https://github.com/machinedi" rel="me">GitHub</a></li>
      <li><a href="https://www.linkedin.com/in/edi-rodin" rel="me">LinkedIn</a></li>
      <li><a href="mailto:edi.rodin@gmail.com">Email</a></li>
    </ul>
  </header>

  <div class="intro">
    <p>
      I started by listing the work I do every day so I could automate it. Sorting email looked easy.
      Answering the configuration questions inside that email did not. That is where this project began.
    </p>
    <p>
      I write here about how my projects are built: the logic, the dead ends, and the rules that made
      them hold. When a small business needs a simple, reliable automation, I can help with that too.
    </p>
  </div>

  <div class="topic-stack">
    <article class="project-card topic-card">
      <h2><a href={withBase(knowledgeTopic.href)}>{knowledgeTopic.label}</a></h2>
      <p class="entry-title"><a href={knowledgeEntry.href}>{knowledgeEntry.title}</a></p>
      <p class="entry-line">{knowledgeEntry.line}</p>
    </article>
    <article class="project-card topic-card">
      <h2><a href={withBase(agentTopic.href)}>{agentTopic.label}</a></h2>
      <p class="entry-title">
        <a href={withBase(`/${agentTopic.key}/${latestAgent.id}/`)}>{latestAgent.data.title}</a>
      </p>
      <p class="entry-line">{latestAgent.data.dek}</p>
    </article>
  </div>

  <section class="section" aria-labelledby="principles-heading">
    <h2 id="principles-heading">Principles</h2>
    <ul class="quotes">
      <li>
        <blockquote>
          <p>a rule nobody can retrieve is not binding</p>
        </blockquote>
      </li>
      <li>
        <blockquote>
          <p>A wall of questions is how a queue gets ignored</p>
        </blockquote>
      </li>
      <li>
        <blockquote>
          <p>Deleting or masking a file does not un-leak it.</p>
        </blockquote>
      </li>
    </ul>
  </section>

  <p class="help-line">
    Need a simple, efficient automation for a small business process?
    <a href={withBase('/help/')}>Write to me</a>. Plain scope, no transformation pitch.
  </p>
</BaseLayout>
