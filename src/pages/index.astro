---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

const featured = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const recentNotes = (await getCollection('notes'))
  .filter((note) => note.data.status === 'published')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Edi Rodin · machinedi"
  description="Edi Rodin documents the systems he builds and the hard logic behind them. Simple, reliable automations for small and mid-size businesses when needed."
>
  <h1>Edi Rodin</h1>
  <p class="position">Builder who documents systems and the hard logic behind them.</p>

  <div class="lede">
    <p>
      I write down the projects I build and the logical problems they had to survive. When a
      small or mid-size business needs a simple, reliable automation, I help design and ship it.
    </p>
  </div>

  <div class="section-head">
    <h2>Projects</h2>
    <a href={withBase('/projects/')}>All projects</a>
  </div>
  <ul class="entry-list">
    {
      featured.map((project) => (
        <li>
          <p class="entry-status">{project.data.status}</p>
          <a class="title" href={withBase(`/projects/${project.id}/`)}>
            {project.data.title}
          </a>
          <p>{project.data.summary}</p>
        </li>
      ))
    }
  </ul>

  {
    recentNotes.length > 0 && (
      <>
        <div class="section-head">
          <h2>Notes</h2>
          <a href={withBase('/notes/')}>All notes</a>
        </div>
        <ul class="entry-list">
          {recentNotes.map((note) => (
            <li>
              <p class="note-status">
                {note.data.pubDate.toLocaleDateString('en-GB', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </p>
              <a class="title" href={withBase(`/notes/${note.id}/`)}>
                {note.data.title}
              </a>
              <p>{note.data.description}</p>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <section class="help">
    <h2>Help</h2>
    <p>
      If you run a small or mid-size business and need a simple, efficient process or
      automation, I take on a limited amount of that work. Email is the right place to start.
    </p>
    <p class="meta-links">
      <a href="mailto:edi.rodin@gmail.com">edi.rodin@gmail.com</a>
      <a href="https://www.linkedin.com/in/edi-rodin">LinkedIn</a>
    </p>
  </section>
</BaseLayout>
