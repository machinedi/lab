---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const built = projects.filter((project) => project.data.kind === 'project');
const labNotes = projects.filter((project) => project.data.kind === 'lab-note');
---

<BaseLayout
  title="Projects · machinedi"
  description="Systems Edi Rodin built, plus a few personal household lab notes."
>
  <h1>Projects</h1>
  <div class="page-intro">
    <p>Systems I built, plus a few personal household lab notes. The lab notes are not products.</p>
  </div>

  <ul class="entry-list">
    {
      built.map((project) => (
        <li>
          <p class="entry-status">{project.data.status}</p>
          <a class="title" href={withBase(`/projects/${project.id}/`)}>
            {project.data.title}
          </a>
          <p>{project.data.summary}</p>
        </li>
      ))
    }
  </ul>

  <div class="section-head">
    <h2>Personal lab notes</h2>
  </div>
  <ul class="entry-list">
    {
      labNotes.map((project) => (
        <li>
          <p class="entry-status">{project.data.status}</p>
          <a class="title" href={withBase(`/projects/${project.id}/`)}>
            {project.data.title}
          </a>
          <p>{project.data.summary}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
