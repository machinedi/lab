---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Not found · machinedi" description="This page is not on the site.">
  <div class="not-found">
    <h1>Nothing here</h1>
    <p class="page-intro">That URL is not a page on this site.</p>
    <p class="meta-links">
      <a href={withBase('/')}>Home</a>
      <a href={withBase('/projects/')}>Projects</a>
      <a href={withBase('/notes/')}>Notes</a>
      <a href={withBase('/help/')}>Help</a>
      <a href={withBase('/contact/')}>Contact</a>
    </p>
  </div>
</BaseLayout>
