---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';

const notes = await getCollection('notes');
const published = notes
  .filter((note) => note.data.listing === 'full')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const abstracts = notes.filter((note) => note.data.listing === 'abstract');
const titles = notes.filter((note) => note.data.listing === 'title');
const hasDrafts = abstracts.length > 0 || titles.length > 0;
---

<BaseLayout
  title="Notes · machinedi"
  description="Short notes on systems Edi Rodin builds and the logic behind them."
  unlisted
>
  <h1>Notes</h1>
  <div class="page-intro">
    <p>
      Short writeups on systems work. I publish a note when it is tight enough to stand on its
      own. RSS is available if you want new ones.
    </p>
    <p class="meta-links">
      <a href={withBase('/rss.xml')}>RSS</a>
    </p>
  </div>

  <ul class="entry-list">
    {
      published.map((note) => (
        <li>
          <p class="note-status">
            {note.data.pubDate.toLocaleDateString('en-GB', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            })}
          </p>
          <a class="title" href={withBase(`/notes/${note.id}/`)}>
            {note.data.title}
          </a>
          <p>{note.data.description}</p>
        </li>
      ))
    }
  </ul>

  {
    hasDrafts && (
      <>
        <div class="section-head">
          <h2>Drafts</h2>
        </div>
        <ul class="entry-list">
          {abstracts.map((note) => (
            <li>
              <p class="note-status">Draft</p>
              <a class="title" href={withBase(`/notes/${note.id}/`)}>
                {note.data.title}
              </a>
              <p class="note-abstract">{note.data.description}</p>
            </li>
          ))}
        </ul>
        <ul class="coming-list">
          {titles.map((note) => (
            <li>
              {note.data.title}
              <span class="coming-flag">draft</span>
            </li>
          ))}
        </ul>
      </>
    )
  }
</BaseLayout>
