---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const topicLabel = post.data.topic === 'knowledge' ? 'Knowledge' : 'Agent Building';
const topicHref = withBase(`/${post.data.topic}/`);
const published = post.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<BaseLayout title={`${post.data.title} · Edi Rodin`} description={post.data.dek}>
  <p class="post-kicker">
    <a href={topicHref}>{topicLabel}</a>
  </p>
  <h1>{post.data.title}</h1>
  <p class="lede">{post.data.dek}</p>
  <p class="post-meta">
    <time datetime={post.data.date.toISOString().slice(0, 10)}>{published}</time>
    <span aria-hidden="true"> · </span>
    <span>{post.data.readingTime}</span>
  </p>
  <article class="post">
    <slot />
  </article>
</BaseLayout>
