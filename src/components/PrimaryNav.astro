---
import { getCollection } from 'astro:content';
import { primaryNav, currentPath, isNavActive } from '../lib/nav';
import { withBase } from '../lib/paths';
import { topics, type Topic } from '../lib/topics';

const current = currentPath(Astro.url.pathname, import.meta.env.BASE_URL);

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

interface PanelEntry {
  href: string;
  title: string;
  summary: string;
}

function entriesFor(topic: Topic): PanelEntry[] {
  const entries: PanelEntry[] = [];
  if (topic.pinned) {
    entries.push({
      href: topic.pinned.href,
      title: topic.pinned.title,
      summary: topic.pinned.summary,
    });
  }
  for (const post of posts) {
    if (post.data.topic !== topic.key) continue;
    entries.push({
      href: `/${topic.key}/${post.id}/`,
      title: post.data.title,
      summary: post.data.dek,
    });
  }
  return entries;
}

function isExact(href: string): boolean {
  const path = href.replace(/\/$/, '') || '/';
  return current === path;
}
---

<header class="site-header">
  <a class="brand" href={withBase('/')}>
    <span class="brand-name">Edi Rodin</span>
    <span class="brand-note">notes from the lab</span>
  </a>
  <nav class="nav" aria-label="Primary" data-primary-nav>
    <ul>
      {
        primaryNav.map((item) => {
          const active = isNavActive(current, item.match, item.match === '/');
          if (!item.topic) {
            return (
              <li>
                <a href={withBase(item.href)} aria-current={active ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          }

          const topic = topics[item.topic];
          const panelId = `nav-panel-${topic.key}`;
          const linkId = `nav-link-${topic.key}`;
          const entries = entriesFor(topic);

          return (
            <li class="nav-menu" data-nav-menu>
              <div class="nav-topic">
                <a id={linkId} href={withBase(item.href)} aria-current={active ? 'page' : undefined}>
                  {item.label}
                </a>
                <button
                  type="button"
                  class="nav-toggle"
                  aria-expanded="false"
                  aria-controls={panelId}
                  aria-label={`${topic.label} menu`}
                >
                  <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                    <path
                      d="M2.2 4.4 6 8.1l3.8-3.7"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
              </div>
              <div class="nav-panel" id={panelId} aria-labelledby={linkId}>
                {
                  entries.length > 0 && (
                    <ul class="nav-panel-list">
                      {entries.map((entry) => (
                        <li>
                          <a
                            class="nav-panel-link"
                            href={withBase(entry.href)}
                            aria-current={isExact(entry.href) ? 'page' : undefined}
                          >
                            <span class="nav-panel-title">{entry.title}</span>
                            <span class="nav-panel-dek">{entry.summary}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )
                }
                <a
                  class="nav-panel-all"
                  href={withBase(topic.href)}
                  aria-current={isExact(topic.href) ? 'page' : undefined}
                >
                  All in {topic.label} →
                </a>
              </div>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    var nav = document.querySelector('[data-primary-nav]');
    if (!nav || nav.getAttribute('data-ready') === 'true') return;
    nav.setAttribute('data-ready', 'true');

    var items = Array.prototype.slice.call(nav.querySelectorAll('[data-nav-menu]'));
    var fineHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    var narrow = window.matchMedia('(max-width: 720px)');
    var blockFocusOpen = false;

    function canHover() {
      return fineHover.matches;
    }

    function buttonOf(item) {
      return item.querySelector('.nav-toggle');
    }

    function panelOf(item) {
      var button = buttonOf(item);
      var id = button && button.getAttribute('aria-controls');
      return id ? document.getElementById(id) : null;
    }

    function isOpen(item) {
      return item.classList.contains('is-open');
    }

    function within(item, node) {
      if (!node) return false;
      var panel = panelOf(item);
      return item.contains(node) || (!!panel && panel.contains(node));
    }

    function place(item) {
      var panel = panelOf(item);
      if (!panel) return;
      if (narrow.matches) {
        panel.style.left = '';
        return;
      }
      panel.style.left = '0px';
      var margin = 12;
      var rect = panel.getBoundingClientRect();
      var shift = 0;
      if (rect.right > window.innerWidth - margin) {
        shift -= rect.right - (window.innerWidth - margin);
      }
      if (rect.left + shift < margin) {
        shift += margin - (rect.left + shift);
      }
      panel.style.left = shift + 'px';
    }

    function relocate(item) {
      var panel = panelOf(item);
      if (!panel) return;
      if (narrow.matches) {
        if (panel.parentElement !== nav) nav.appendChild(panel);
        panel.style.left = '';
        return;
      }
      if (panel.parentElement !== item) item.appendChild(panel);
    }

    function close(item) {
      var panel = panelOf(item);
      var button = buttonOf(item);
      item.classList.remove('is-open');
      if (panel) panel.classList.remove('is-open');
      if (button) button.setAttribute('aria-expanded', 'false');
    }

    function open(item) {
      items.forEach(function (other) {
        if (other !== item) close(other);
      });
      var panel = panelOf(item);
      var button = buttonOf(item);
      relocate(item);
      item.classList.add('is-open');
      if (panel) panel.classList.add('is-open');
      if (button) button.setAttribute('aria-expanded', 'true');
      place(item);
    }

    items.forEach(function (item) {
      var button = buttonOf(item);
      if (!button) return;

      item.addEventListener('pointerenter', function () {
        if (!canHover()) return;
        open(item);
      });

      item.addEventListener('pointerleave', function (event) {
        if (!canHover()) return;
        if (within(item, event.relatedTarget)) return;
        var active = document.activeElement;
        if (within(item, active)) return;
        close(item);
      });

      item.addEventListener('focusin', function () {
        if (blockFocusOpen) return;
        open(item);
      });

      item.addEventListener('focusout', function (event) {
        if (within(item, event.relatedTarget)) return;
        if (canHover() && item.matches(':hover')) return;
        close(item);
      });

      button.addEventListener('pointerdown', function () {
        button.setAttribute('data-was-open', isOpen(item) ? 'true' : 'false');
        button.setAttribute('data-pointer', 'true');
      });

      button.addEventListener('click', function () {
        var fromPointer = button.getAttribute('data-pointer') === 'true';
        var wasOpen = button.getAttribute('data-was-open') === 'true';
        button.removeAttribute('data-pointer');
        button.removeAttribute('data-was-open');
        if (fromPointer && !wasOpen && isOpen(item)) return;
        if (isOpen(item)) close(item);
        else open(item);
      });

      button.addEventListener('keydown', function (event) {
        if (event.key !== 'ArrowDown') return;
        var panel = panelOf(item);
        var first = panel && panel.querySelector('a');
        if (!first) return;
        event.preventDefault();
        open(item);
        first.focus();
      });
    });

    document.addEventListener('pointerdown', function (event) {
      items.forEach(function (item) {
        if (!within(item, event.target)) close(item);
      });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      var currentItem = null;
      items.forEach(function (item) {
        if (!currentItem && isOpen(item)) currentItem = item;
      });
      if (!currentItem) return;
      event.preventDefault();
      var button = buttonOf(currentItem);
      blockFocusOpen = true;
      close(currentItem);
      if (button) button.focus();
      setTimeout(function () {
        blockFocusOpen = false;
      }, 0);
    });

    window.addEventListener('resize', function () {
      items.forEach(function (item) {
        relocate(item);
        if (isOpen(item)) place(item);
      });
    });
  })();
</script>
