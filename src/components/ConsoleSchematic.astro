---
interface Props {
  title?: string;
}

const { title = 'Agent work becomes a trackable workflow, then a documented output.' } = Astro.props;
---

<figure class="schematic-wrap">
  <svg
    class="schematic"
    viewBox="0 0 760 280"
    role="img"
    aria-labelledby="schematic-title schematic-desc"
  >
    <title id="schematic-title">Operations loop schematic</title>
    <desc id="schematic-desc">{title}</desc>
    <rect x="0" y="0" width="760" height="280" fill="#ebe6db"></rect>
    <g fill="none" stroke="#1c1917" stroke-width="1.25">
      <rect x="36" y="48" width="180" height="88"></rect>
      <rect x="290" y="48" width="180" height="88"></rect>
      <rect x="544" y="48" width="180" height="88"></rect>
      <path d="M216 92 H290" marker-end="url(#arrow)"></path>
      <path d="M470 92 H544" marker-end="url(#arrow)"></path>
      <path d="M634 136 V196 H126 V92" marker-end="url(#arrow)"></path>
    </g>
    <defs>
      <marker id="arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
        <path d="M0 0 L8 4 L0 8 Z" fill="#8f3d2c"></path>
      </marker>
    </defs>
    <g font-family="IBM Plex Sans, Segoe UI, sans-serif" fill="#1c1917">
      <text x="126" y="78" text-anchor="middle" font-size="11" letter-spacing="1.6" fill="#6e2c1f">01</text>
      <text x="126" y="100" text-anchor="middle" font-size="16">Agents</text>
      <text x="126" y="118" text-anchor="middle" font-size="11" fill="#57534e">do the repeating work</text>
      <text x="380" y="78" text-anchor="middle" font-size="11" letter-spacing="1.6" fill="#6e2c1f">02</text>
      <text x="380" y="100" text-anchor="middle" font-size="15">Trackable workflows</text>
      <text x="380" y="118" text-anchor="middle" font-size="11" fill="#57534e">step, owner, status</text>
      <text x="634" y="78" text-anchor="middle" font-size="11" letter-spacing="1.6" fill="#6e2c1f">03</text>
      <text x="634" y="100" text-anchor="middle" font-size="15">Documented outputs</text>
      <text x="634" y="118" text-anchor="middle" font-size="11" fill="#57534e">kept with the step</text>
      <text x="380" y="214" text-anchor="middle" font-size="12" fill="#1f3d32">
        write-back: logs, artifacts, the next allowed action
      </text>
    </g>
  </svg>
  <figcaption class="schematic-caption">
    The loop, not a screenshot: agents feed workflows, workflows keep outputs, outputs feed the next pass.
  </figcaption>
</figure>
